{
  "expo": {
    "name": "bible-app",
    "slug": "bible-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bibleapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bibleproject.bibleapp",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.bibleproject.bibleapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#659DF2",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#659DF2",
          "dark": {
            "backgroundColor": "#659DF2"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "09edc63d-1e2e-4333-925b-06ff80f2d84d"
      }
    },
    "owner": "kevin24"
  }
}
